# =========================================================================
# CyberSaarthi – Environment Configuration
# =========================================================================

# Flask Application Secret & Port
SECRET_KEY=cybersaarthi_super_secret_jwt_key_2026_change_in_production
FLASK_ENV=development
PORT=5000

# -------------------------------------------------------------------------
# RDBMS Database Configuration (MySQL 8.0+)
# -------------------------------------------------------------------------
# Default MySQL Database Name: cybersaarthi_db
# URL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/cybersaarthi_db

# If MySQL is not reachable or during lightweight dev/testing, CyberSaarthi
# seamlessly falls back to:
# DATABASE_URL=sqlite:///cybersaarthi.db

# -------------------------------------------------------------------------
# External Threat Intelligence APIs (Optional - Heuristic engine runs offline if unset)
# -------------------------------------------------------------------------
# Google Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal v3 API
VIRUSTOTAL_API_KEY=

# URLScan.io API
URLSCAN_API_KEY=

# -------------------------------------------------------------------------
# Regional Voice / Speech AI (Optional - Browser Web Speech API is default)
# -------------------------------------------------------------------------
SARVAM_API_KEY=
WHISPER_API_KEY=
