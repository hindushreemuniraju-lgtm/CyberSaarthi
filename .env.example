# CyberSaarthi Environment Configuration

# Flask Application
SECRET_KEY=cybersaarthi_super_secret_jwt_key_2026_change_in_production
FLASK_ENV=development
PORT=5000

# Database Configuration (MySQL recommended)
# Default format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cybersaarthi
# If MySQL is not configured or unavailable, system automatically falls back to:
# sqlite:///cybersaarthi.db

# External Threat Intelligence APIs (Optional - Local engine activates if omitted)
# Google Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal v3 API
VIRUSTOTAL_API_KEY=

# URLScan.io API
URLSCAN_API_KEY=

# Regional Voice / Speech AI (Optional - Browser Web Speech API used by default)
SARVAM_API_KEY=
WHISPER_API_KEY=
